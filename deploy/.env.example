# ============================================================
# xr_teleoperate Docker Deployment Environment Variables
# ============================================================

# ---- Docker Registry Configuration ----
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=dopamineillusory
IMAGE_TAG=latest

# ---- Robot Configuration ----
XR_TELEOP_ARM=G1_29
XR_TELEOP_FREQUENCY=30.0
XR_TELEOP_INPUT_MODE=controller
XR_TELEOP_DISPLAY_MODE=immersive

# ---- Network Configuration ----
# IMG_SERVER_IP: 宿主机实际 IP，XR 设备连接 WiFi 后访问的 IP
# 如果不设置，容器启动时会自动检测
# 示例: IMG_SERVER_IP=192.168.2.203
IMG_SERVER_IP=
DDS_INTERFACE=eth0

# ---- Simulation Configuration ----
ISAAC_TASK=Isaac-PickPlace-Cylinder-G129-Dex3-Joint

# ---- Display Configuration ----
DISPLAY=:0
